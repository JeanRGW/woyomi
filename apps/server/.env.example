# Optional self-hosted backend config (apps/server)
SYNC_TOKEN=changeme
DATA_DIR=./data
PORT=8787

# Web-mode fetch + stream proxy (POST /api/scrape, GET /api/stream). Off by
# default so this server is not an open proxy; a self-hoster enables it and may
# gate it with a token (streamed as ?token= since <video> can't send headers).
SCRAPE_ENABLED=false
SCRAPE_TOKEN=
