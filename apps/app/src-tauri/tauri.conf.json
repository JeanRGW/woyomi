{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Media Platform",
  "version": "0.1.0",
  "identifier": "com.mediaplatform.app",
  "build": {
    "beforeDevCommand": "pnpm --filter @media-platform/app dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @media-platform/app build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Media Platform",
        "width": 1200,
        "height": 800,
        "minWidth": 700,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
