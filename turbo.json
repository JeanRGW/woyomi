{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "test": { "dependsOn": ["build"] },
    "typecheck": { "dependsOn": ["^build"] },
    "build:plugin": { "dependsOn": ["^build"], "outputs": ["*.plugin.js", "*.plugin.json"] }
  }
}