{
  "name": "@woyomi/plugin-builder",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "author": "JeanRGW",
  "description": "CLI and library that bundles woyomi media plugins into self-contained IIFE bundles with manifests and sha256, plus a Mihon-style repo index generator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeanRGW/woyomi.git",
    "directory": "packages/plugin-builder"
  },
  "homepage": "https://woyomi.rgw.app",
  "bugs": "https://github.com/JeanRGW/woyomi/issues",
  "keywords": [
    "woyomi",
    "plugin",
    "esbuild",
    "bundle",
    "cli",
    "manga",
    "anime",
    "extension"
  ],
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "bin": {
    "woyomi-plugin-build": "bin/woyomi-plugin-build.js",
    "media-plugin-build": "bin/woyomi-plugin-build.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./gen-repo": {
      "types": "./dist/gen-repo.d.ts",
    "default": "./dist/gen-repo.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@woyomi/core": "workspace:*",
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
