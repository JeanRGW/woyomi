{
  "name": "@woyomi/plugin-builder",
  "version": "0.1.1",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin",
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "bin": {
    "media-plugin-build": "bin/media-plugin-build.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./build": {
      "types": "./dist/build.d.ts",
      "default": "./dist/build.js"
    },
    "./gen-repo": {
      "types": "./dist/gen-repo.d.ts",
      "default": "./dist/gen-repo.js"
    }
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@woyomi/core": "workspace:*",
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
