{
  "name": "woyomi",
  "private": true,
  "version": "0.1.0",
  "description": "woyomi - multi-source content aggregator (Tauri app + plugin system)",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "dev": "pnpm --filter @woyomi/app dev",
    "typecheck": "turbo run typecheck",
    "lint": "eslint packages apps/server/src && pnpm --filter @woyomi/app lint",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "turbo": "^2.3.0",
    "typescript-eslint": "^8.66.0"
  }
}